# Keep the build context small: only the files the image build actually reads
# are copied, and everything here is either generated or irrelevant to a build.
.git
.github
.kilo

# Reinstalled inside the image, and huge.
node_modules

# Generated by the image build itself.
dist

# Not needed to produce the bundle.
tests
coverage
vitest.config.js

# Container definitions that are not build inputs. docker/ must NOT be listed
# here: the Dockerfile copies docker/nginx.conf into the runtime image.
Dockerfile
.dockerignore
docker-compose.yml

# Docs and metadata.
README.md
LICENSE.txt
*.log
.DS_Store
Thumbs.db
